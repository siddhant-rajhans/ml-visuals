{
  "name": "@siddhant-rajhans/ml-visuals",
  "version": "0.1.0",
  "description": "Reusable 3D visualizations for ML concepts. Built with React Three Fiber + Manim.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --mode lib",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "machine-learning",
    "visualization",
    "react-three-fiber",
    "threejs",
    "manim",
    "education",
    "ml",
    "3d"
  ],
  "author": "Siddhant Rajhans <https://siddhant-rajhans.github.io/>",
  "license": "MIT",
  "homepage": "https://github.com/siddhant-rajhans/ml-visuals",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siddhant-rajhans/ml-visuals.git"
  },
  "bugs": {
    "url": "https://github.com/siddhant-rajhans/ml-visuals/issues"
  },
  "peerDependencies": {
    "@react-three/drei": ">=9",
    "@react-three/fiber": ">=8",
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.160"
  },
  "devDependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.169.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
